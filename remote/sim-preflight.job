#!/bin/bash
#SBATCH -J preflight
#SBATCH -p Batch
#SBATCH -N 1
#SBATCH -t 00:30:00
#SBATCH -o logs/preflight-%j.out
#SBATCH -e logs/preflight-%j.err

# sim-preflight.job
# Memakai kode dan input yang sama dengan produksi, tapi maxiter dan shots kecil.

set -euo pipefail
cd "$SLURM_SUBMIT_DIR"

PROJECT_DIR="$SLURM_SUBMIT_DIR"
QENV_DIR="$PROJECT_DIR/qenv"

test -x ./remote/job.sh                         || { echo "MISSING: remote/job.sh"; exit 1; }
test -r ./remote/run_quantum.py                  || { echo "MISSING: remote/run_quantum.py"; exit 1; }
test -r ./notebooks/results/raw/qubo_ising_data.pkl || { echo "MISSING: notebooks/results/raw/qubo_ising_data.pkl"; exit 1; }
test -x "$QENV_DIR/bin/python" || { echo "MISSING: $QENV_DIR/bin/python"; exit 1; }

export PYTHONUNBUFFERED=1

echo "job_id=$SLURM_JOB_ID"
echo "nodes=$SLURM_JOB_NUM_NODES"
echo "nodelist=$SLURM_JOB_NODELIST"

mpirun -npernode 4 \
  ./remote/job.sh \
  "$QENV_DIR" \
  "$QENV_DIR/bin/python" ./remote/run_quantum.py \
    --input  notebooks/results/raw/qubo_ising_data.pkl \
    --output "notebooks/results/raw/preflight-${SLURM_JOB_ID}.pkl" \
    --ansatz hva \
    --depth  1 \
    --qubits 30 \
    --gamma-tf 0.2 \
    --shots  16 \
    --seed   123 \
    --maxiter 2
